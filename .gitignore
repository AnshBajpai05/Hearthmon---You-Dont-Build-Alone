.DS_Store
node_modules
/build

# Build secret (NEVER commit) + distributable exes
secret_key.txt
/dist/

# Updater signing key (NEVER commit — rotating it breaks every existing update + signature).
# Lives one level up like secret_key.txt; these are defensive entries in case it's ever copied in.
hearthmon_updater.key
hearthmon_updater.key.pub
updater_key_password.txt
*.key

# Founder's Mark: local builder registry (CRM from issued passes — handles + machine hashes).
# Stays local; commit only the derived badge snippet from tools/builders_badge.ps1.
/tools/builders.json
/tools/passes.log
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# personal-use audio — never publish (ripped/cloned voice clips)
/static/voice/*.mp3
/static/voice/*.wav
/ash_all_voices.mp3
/tools/.venv-voice
/Ash_Voice_Box/

# python caches
__pycache__/
*.pyc

# Combat Identity: raw PokeAPI CSV inputs (bulk + re-downloadable by tools/gen_combat_identity.ps1).
# The DERIVED truth — src/lib/combat_identity.ts — is committed; these raw inputs are not.
/tools/pokeapi/

# kaggle voice-clone kit: ship the scripts, never the IP audio or the zip
/kaggle_voice_clone/reference_clips/*.mp3
/kaggle_voice_clone/reference_clips/*.wav
/kaggle_voice_clone/results/*.mp3
/kaggle_voice_clone/results/*.wav
/hearthmon_kaggle_voice_clone.zip
