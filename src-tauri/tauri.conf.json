{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hearthmon",
  "version": "0.1.0",
  "identifier": "com.hearthmon.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Hearthmon",
        "label": "main",
        "width": 360,
        "height": 410,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AnshBajpai05/Hearthmon-Trial_Beta/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFMDRGMjA1QkMzRDUxNTgKUldSWVVUMjhCZklFM25RVkVxUW5yS0NZUEdmdXJoaldlL0d0RzdRTnRTam8wNFlqREtYaEtjeFoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
