# Throwaway export environment — keep the SCRIPTS, never the heavy/derivable binaries.
# Recreate: python -m venv .venv && .venv/Scripts/pip install "numpy<2" tensorflow==2.15.0 \
#   tensorflow_hub==0.16.1 tf2onnx==1.16.1 onnx onnxruntime && python export_yamnet.py
.venv/
tract_check/target/
# canonical YAMNet weights (re-downloaded from storage.googleapis.com/audioset)
*.h5
# build outputs — the shipped core lives in src-tauri/resources/yamnet/
*.onnx
# reference vectors (regenerated by export_yamnet.py)
*.npz
